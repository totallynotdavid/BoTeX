# Copy to .env (mise and systemd's EnvironmentFile= read it). Every line is
# optional; a blank value uses the default, which a note gives when the bots
# differ. Generated from the settings the bots read. To change it, change the
# code and run: mise run env:example

# Shared by every bot ---------------------------------------------------------

# SQLite file holding the WhatsApp session, users and ranks.
BOTKIT_STORE_PATH=botkit.db

# debug, info, warn or error.
BOTKIT_LOG_LEVEL=info

# Comma-separated JIDs registered as owners on every start, for example
# 51999999999@s.whatsapp.net. Without one, nobody can run a command until a
# user is added to the database by hand.
BOTKIT_OWNER_JIDS=

# Requests each user may send per period. Over the limit the bot reacts with a
# warning and sends one notice per cooldown.
# Defaults: latex 5, flow 20.
BOTKIT_RATE_LIMIT_REQUESTS=

# How long a request counts against the limit, as a Go duration.
BOTKIT_RATE_LIMIT_PERIOD=1m

# Least time between two notices to a user who stays over the limit, as a Go
# duration.
# Defaults: latex 5m, flow 1m.
BOTKIT_RATE_LIMIT_COOLDOWN=

# Messages handled at once. Beyond it the bot answers "too many requests".
BOTKIT_MAX_IN_FLIGHT=10

# Answer messages sent from the bot's own WhatsApp account.
BOTKIT_OWN_MESSAGES=false

# Comma-separated JIDs the bot answers. Messages from anyone else are ignored.
# Empty answers everyone. Useful to test a bot on a number others also message.
BOTKIT_ALLOW_ONLY=

# latex bot -------------------------------------------------------------------

# The typst executable, as a path or a name looked up on PATH. Set the path of
# the binary itself where PATH holds only a version-manager shim, such as under
# a service manager.
LATEX_TYPST_BIN=typst

# Most characters of LaTeX one message may hold.
LATEX_MAX_LENGTH=1000

# Largest PNG the bot sends, in bytes.
LATEX_MAX_IMAGE_BYTES=5242880

# Longest a render may run, as a Go duration.
LATEX_TIMEOUT=10s

# Data memory the typst process may use, in bytes.
LATEX_DATA_LIMIT_BYTES=268435456

# Largest file the typst process may write, in bytes.
LATEX_FILE_SIZE_LIMIT_BYTES=16777216

# flow bot --------------------------------------------------------------------

# JSON file with the conversation. Empty runs the example flow built into the
# binary. A file that cannot be read or is not a valid flow stops the bot.
FLOW_FILE=

# Directory for the payment vouchers users send. Created on the first one.
FLOW_VOUCHER_DIR=vouchers

# How long the bot waits before each reply, as a Go duration. 0s replies at
# once.
FLOW_TYPING_DELAY=0s
