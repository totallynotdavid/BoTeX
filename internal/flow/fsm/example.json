{
  "start_node": "GREETING_INTRO",
  "transition_groups": {
    "main_menu_options": [
      { "condition": { "type": "keyword", "value": ["1", "nuevos", "principiante"] }, "target": "INTERESTED_IN_BEGINNER" },
      { "condition": { "type": "keyword", "value": ["2", "avanzado", "generos"] }, "target": "INTERESTED_IN_ADVANCED_CATEGORIES" },
      { "condition": { "type": "keyword", "value": ["precio", "precios", "costo", "cuesta", "matricula"] }, "target": "CONSULTED_PRICE" },
      { "condition": { "type": "keyword", "value": ["horario", "horarios", "hora"] }, "target": "CONSULTED_SCHEDULE" },
      { "condition": { "type": "keyword", "value": ["inscribirme", "inscripcion"] }, "target": "CLARIFY_ENROLLMENT_COURSE" }
    ],
    "common_navigation": [
      { "condition": { "type": "keyword", "value": ["menu", "inicio"] }, "target": "MAIN_MENU" },
      { "condition": { "type": "keyword", "value": ["precio", "precios"] }, "target": "CONSULTED_PRICE" },
      { "condition": { "type": "keyword", "value": ["horario", "horarios"] }, "target": "CONSULTED_SCHEDULE" }
    ],
    "club_options": [
      { "condition": { "type": "keyword", "value": ["misterio", "policial"] }, "target": "CLUB_MISTERIO" },
      { "condition": { "type": "keyword", "value": ["historica", "historia"] }, "target": "CLUB_HISTORICA" },
      { "condition": { "type": "keyword", "value": ["poesia", "poemas"] }, "target": "CLUB_POESIA" }
    ],
    "confirm_enrollment": [
      { "condition": { "type": "keyword", "value": ["no", "cancelar", "volver"] }, "target": "ENROLLMENT_CANCELLED" },
      { "condition": { "type": "keyword", "value": ["si", "confirmo", "confirmar"] }, "target": "ENROLLMENT_PROCESS" }
    ]
  },
  "global_transitions": [
    { "condition": { "type": "keyword", "value": ["quita mi nombre", "borra mi nombre"] }, "target": "NAME_REMOVED_CONFIRMATION", "action": "clear_user_name" },
    { "condition": { "type": "regex", "regex": "^(me llamo|mi nombre es|llamame|llámame)\\s+\\S+" }, "target": "NAME_CHANGE_CONFIRMED", "action": "save_user_name" },
    { "condition": { "type": "keyword", "value": ["cambiar nombre", "cambiar mi nombre"] }, "target": "CHANGE_NAME_PROMPT" },
    { "condition": { "type": "keyword", "value": ["ayuda", "asesor", "asesora", "agente"] }, "target": "NEEDS_ASSISTANCE" },
    { "condition": { "type": "keyword", "value": ["menu", "inicio"] }, "target": "MAIN_MENU" },
    { "condition": { "type": "keyword", "value": ["adios", "chau", "hasta luego"] }, "target": "CONVERSATION_CLOSED" }
  ],
  "nodes": {
    "GREETING_INTRO": {
      "title": "Bienvenida",
      "message": { "type": "text", "content": "{{greeting}} 👋 Soy el asistente de *Librería Página Nueva*. Organizamos clubes de lectura todo el año.\n\n1️⃣ Club para lectores nuevos\n2️⃣ Clubs por género\n\nTambién puedes preguntarme por *precios* u *horarios*." },
      "action": "create_new_lead",
      "include_transitions": "main_menu_options"
    },
    "MAIN_MENU": {
      "title": "Menú principal",
      "message": { "type": "text", "content": "¿En qué te puedo ayudar, {{name}}?\n\n1️⃣ Club para lectores nuevos\n2️⃣ Clubs por género\n\nO escribe *precios*, *horarios* o *inscribirme*." },
      "include_transitions": "main_menu_options"
    },
    "INTERESTED_IN_BEGINNER": {
      "title": "Club para lectores nuevos",
      "message": { "type": "text", "content": "El *Club Primeras Páginas* es para quien quiere retomar la lectura: un libro corto al mes, sin tareas.\n\nEscribe *inscribirme* para apuntarte o *menú* para volver." },
      "action": "update_lead_interest_beginner",
      "include_transitions": "common_navigation",
      "transitions": [
        { "condition": { "type": "keyword", "value": ["inscribirme", "inscripcion"] }, "target": "CONFIRM_ENROLLMENT_BEGINNER" }
      ]
    },
    "INTERESTED_IN_ADVANCED_CATEGORIES": {
      "title": "Clubs por género",
      "message": { "type": "text", "content": "Estos son nuestros géneros:\n\n1️⃣ Ficción\n2️⃣ Poesía\n\nO escribe *catálogo* para ver todos los clubs." },
      "action": "update_lead_interest_advanced",
      "include_transitions": "common_navigation",
      "transitions": [
        { "condition": { "type": "exact", "value": ["1"] }, "target": "ADVANCED_MENU_FICTION" },
        { "condition": { "type": "exact", "value": ["2"] }, "target": "ADVANCED_MENU_POETRY" },
        { "condition": { "type": "keyword", "value": ["ficcion", "novela"] }, "target": "ADVANCED_MENU_FICTION" },
        { "condition": { "type": "keyword", "value": ["catalogo"] }, "target": "CONSULTED_CATALOG" }
      ]
    },
    "ADVANCED_MENU_FICTION": {
      "title": "Clubs de ficción",
      "message": { "type": "text", "content": "Clubs de ficción:\n\n• *Misterio*: novela policial\n• *Histórica*: novela histórica\n\nEscribe el nombre del club o *volver*." },
      "include_transitions": "club_options",
      "transitions": [
        { "condition": { "type": "keyword", "value": ["volver"] }, "target": "INTERESTED_IN_ADVANCED_CATEGORIES" }
      ]
    },
    "ADVANCED_MENU_POETRY": {
      "title": "Clubs de poesía",
      "message": { "type": "text", "content": "Club de poesía:\n\n• *Poesía*: un poeta distinto cada mes\n\nEscribe *poesía* o *volver*." },
      "include_transitions": "club_options",
      "transitions": [
        { "condition": { "type": "keyword", "value": ["volver"] }, "target": "INTERESTED_IN_ADVANCED_CATEGORIES" }
      ]
    },
    "CONSULTED_CATALOG": {
      "title": "Catálogo",
      "message": { "type": "text", "content": "Todos los clubs: *misterio*, *histórica* y *poesía*. Escribe el nombre del que te interese o *menú*." },
      "include_transitions": "club_options"
    },
    "CLUB_MISTERIO": {
      "title": "Club Misterio",
      "message": { "type": "text", "content": "*Club Misterio*: novela policial, los martes a las 7 p. m., S/ 40 al mes.\n\nEscribe *inscribirme* o *menú*." },
      "ignore_global_transitions": true,
      "include_transitions": "common_navigation",
      "transitions": [
        { "condition": { "type": "keyword", "value": ["inscribirme", "inscripcion"] }, "target": "CONFIRM_ENROLLMENT", "action": "set_selected_course" }
      ]
    },
    "CLUB_HISTORICA": {
      "title": "Club Histórica",
      "message": { "type": "text", "content": "*Club Histórica*: novela histórica, los jueves a las 7 p. m., S/ 40 al mes.\n\nEscribe *inscribirme* o *menú*." },
      "ignore_global_transitions": true,
      "include_transitions": "common_navigation",
      "transitions": [
        { "condition": { "type": "keyword", "value": ["inscribirme", "inscripcion"] }, "target": "CONFIRM_ENROLLMENT", "action": "set_selected_course" }
      ]
    },
    "CLUB_POESIA": {
      "title": "Club Poesía",
      "message": { "type": "text", "content": "*Club Poesía*: un poeta distinto cada mes, los sábados a las 11 a. m., S/ 30 al mes.\n\nEscribe *inscribirme* o *menú*." },
      "ignore_global_transitions": true,
      "include_transitions": "common_navigation",
      "transitions": [
        { "condition": { "type": "keyword", "value": ["inscribirme", "inscripcion"] }, "target": "CONFIRM_ENROLLMENT", "action": "set_selected_course" }
      ]
    },
    "CONSULTED_PRICE": {
      "title": "Precios",
      "message": { "type": "text", "content": "Los clubs cuestan entre S/ 30 y S/ 40 al mes. La inscripción es gratis.\n\nEscribe *inscribirme*, *horarios* o *menú*." },
      "action": "update_lead_consulted_price",
      "include_transitions": "main_menu_options"
    },
    "CONSULTED_SCHEDULE": {
      "title": "Horarios",
      "message": { "type": "text", "content": "Nos reunimos martes y jueves a las 7 p. m. y sábados a las 11 a. m.\n\nEscribe *inscribirme*, *precios* o *menú*." },
      "include_transitions": "main_menu_options"
    },
    "CLARIFY_ENROLLMENT_COURSE": {
      "title": "¿A qué club?",
      "message": { "type": "text", "content": "¿A qué club quieres inscribirte?\n\n1️⃣ Club para lectores nuevos\n2️⃣ Un club por género" },
      "transitions": [
        { "condition": { "type": "exact", "value": ["1"] }, "target": "CONFIRM_ENROLLMENT_BEGINNER" },
        { "condition": { "type": "exact", "value": ["2"] }, "target": "PROMPT_ADVANCED_COURSE_FOR_ENROLLMENT" },
        { "condition": { "type": "keyword", "value": ["nuevos", "principiante"] }, "target": "CONFIRM_ENROLLMENT_BEGINNER" }
      ]
    },
    "PROMPT_ADVANCED_COURSE_FOR_ENROLLMENT": {
      "title": "Elegir club",
      "message": { "type": "text", "content": "Elige un club: *misterio*, *histórica* o *poesía*." },
      "include_transitions": "club_options"
    },
    "CONFIRM_ENROLLMENT_BEGINNER": {
      "title": "Confirmar inscripción (nuevos)",
      "message": { "type": "text", "content": "Vas a inscribirte al *Club Primeras Páginas*. ¿Confirmas? Responde *sí* o *cancelar*." },
      "action": "set_selected_course",
      "fallback_message": "Responde *sí* para confirmar tu inscripción o *cancelar* para volver.",
      "include_transitions": "confirm_enrollment"
    },
    "CONFIRM_ENROLLMENT": {
      "title": "Confirmar inscripción",
      "message": { "type": "text", "content": "Vas a inscribirte al club *{{course_name}}*. ¿Confirmas? Responde *sí* o *cancelar*." },
      "fallback_message": "Responde *sí* para confirmar tu inscripción a {{course_name}} o *cancelar* para volver.",
      "include_transitions": "confirm_enrollment"
    },
    "ENROLLMENT_CANCELLED": {
      "title": "Inscripción cancelada",
      "message": { "type": "text", "content": "Listo, no te inscribimos. Si quieres ver otra opción escribe *1*, *2* o *menú*." },
      "include_transitions": "main_menu_options"
    },
    "ENROLLMENT_PROCESS": {
      "title": "Pago",
      "message": { "type": "text", "content": "Para reservar tu cupo, paga a la cuenta de ejemplo 000-0000000-0-00 de *Librería Página Nueva* y envíanos una *foto* del comprobante.\n\nSi aún no pagaste, escribe *listo* cuando termines." },
      "ignore_global_transitions": true,
      "transitions": [
        { "condition": { "type": "media_type", "value": ["image"] }, "target": "PAYMENT_CONFIRMED", "action": "save_payment_voucher" },
        { "condition": { "type": "keyword", "value": ["listo"] }, "target": "WAITING_FOR_VOUCHER" },
        { "condition": { "type": "keyword", "value": ["cancelar", "volver"] }, "target": "ENROLLMENT_CANCELLED" },
        { "condition": { "type": "keyword", "value": ["ayuda"] }, "target": "NEEDS_ASSISTANCE" }
      ]
    },
    "WAITING_FOR_VOUCHER": {
      "title": "Esperando comprobante",
      "message": { "type": "text", "content": "Envíame la *foto* del comprobante cuando la tengas 📸" },
      "ignore_global_transitions": true,
      "transitions": [
        { "condition": { "type": "media_type", "value": ["image"] }, "target": "PAYMENT_CONFIRMED", "action": "save_payment_voucher" },
        { "condition": { "type": "keyword", "value": ["cancelar", "volver"] }, "target": "ENROLLMENT_CANCELLED" }
      ]
    },
    "PAYMENT_CONFIRMED": {
      "title": "Pago recibido",
      "message": { "type": "text", "content": "¡Gracias, {{name}}! Recibimos tu comprobante. Una persona del equipo confirmará tu cupo en las próximas horas." },
      "transitions": [
        { "condition": { "type": "media_type", "value": ["image"] }, "target": "PAYMENT_CONFIRMED_ACK_EXTRA", "action": "save_payment_voucher" }
      ]
    },
    "PAYMENT_CONFIRMED_ACK_EXTRA": {
      "title": "Otro comprobante",
      "message": { "type": "text", "content": "Guardamos también esta imagen. Escribe *menú* si necesitas algo más." },
      "include_transitions": "common_navigation",
      "transitions": [
        { "condition": { "type": "media_type", "value": ["image"] }, "target": "PAYMENT_CONFIRMED_ACK_EXTRA", "action": "save_payment_voucher" }
      ]
    },
    "NEEDS_ASSISTANCE": {
      "title": "Hablar con una persona",
      "message": { "type": "text", "content": "Avisé a una persona del equipo, te escribirá en breve. Si es *urgente*, dímelo. Puedes enviarme una foto o un archivo con los detalles." },
      "action": "escalate_to_human_agent",
      "transitions": [
        { "condition": { "type": "keyword", "value": ["urgente"] }, "target": "URGENT_ASSISTANCE" },
        { "condition": { "type": "media" }, "target": "ASSISTANCE_ATTACHMENT" }
      ]
    },
    "URGENT_ASSISTANCE": {
      "title": "Ayuda urgente",
      "message": { "type": "text", "content": "Marcado como urgente. Te atenderemos lo antes posible." }
    },
    "ASSISTANCE_ATTACHMENT": {
      "title": "Archivo recibido",
      "message": { "type": "text", "content": "Recibimos tu archivo y se lo pasé a la persona que te atenderá." },
      "include_transitions": "common_navigation"
    },
    "CHANGE_NAME_PROMPT": {
      "title": "Cambiar nombre",
      "message": { "type": "text", "content": "¿Cómo quieres que te llame? Escribe solo tu nombre." },
      "ignore_global_transitions": true,
      "fallback_message": "Escribe solo tu nombre, por favor. No entiendo los archivos ni los mensajes vacíos.",
      "transitions": [
        { "condition": { "type": "any_text" }, "target": "NAME_CHANGE_CONFIRMED", "action": "save_user_name" }
      ]
    },
    "NAME_CHANGE_CONFIRMED": {
      "title": "Nombre guardado",
      "message": { "type": "text", "content": "Perfecto, {{name}}. ¿Qué más necesitas? Escribe *menú* para ver las opciones." },
      "include_transitions": "main_menu_options"
    },
    "NAME_REMOVED_CONFIRMATION": {
      "title": "Nombre eliminado",
      "message": { "type": "text", "content": "Listo, ya no uso tu nombre. Escribe *menú* para ver las opciones." },
      "include_transitions": "main_menu_options"
    },
    "CONVERSATION_CLOSED": {
      "title": "Despedida",
      "message": { "type": "text", "content": "¡Gracias por escribirnos! Cuando quieras volver, envíame cualquier mensaje 📚" },
      "transitions": [
        { "condition": { "type": "any_text" }, "target": "MAIN_MENU" }
      ]
    }
  }
}
